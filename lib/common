#!/bin/bash
# ============================================================
# lib/common
#
# Shared functions and variables used by all compositors.
# This file is always loaded (sourced) by the main script
# before any compositor module.
# ============================================================

# Steam binary and arguments, used by compositors that
# launch Steam directly (KWin, SteamOS/Gamescope, etc).
STEAM_BIN="/usr/bin/steam"
STEAM_ARGS=(-gamepadui)


# ------------------------------------------------------------
# report_failure <title> [status]
# Displays a standardized error message on the screen and pauses
# execution until the user presses ENTER.
# ------------------------------------------------------------
report_failure() {
    local title="$1"
    local status="${2:-}"

    clear

    echo "=================================="
    echo "       $title"
    echo "=================================="
    echo

    if [[ -n "$status" ]]; then
        echo "Exit code: $status"
        echo
    fi

    read -rp "Press ENTER to return to the menu..."
}
