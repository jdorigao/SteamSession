#!/bin/bash
# ============================================================
# compositors/steamos.sh
#
# Inicialização do Gamescope (modo "SteamOS"), com a Steam
# (GamepadUI) rodando dentro da sessão.
# ============================================================

GAMESCOPE_BIN="gamescope"
GAMESCOPE_ARGS=(--backend drm -e)


start_steamos() {

    local log_file
    local status

    log_file="$(new_log_file steamos)"

    create_log_header "$log_file" "STEAMOS (GAMESCOPE) SESSION LOG"

    {
        echo "========== GAMESCOPE =========="
        "$GAMESCOPE_BIN" --version
        echo

        echo "========== EXECUÇÃO =========="
    } >> "$log_file" 2>&1


    # Toda a saída vai para o log.
    "$GAMESCOPE_BIN" \
        "${GAMESCOPE_ARGS[@]}" \
        -- \
        "$STEAM_BIN" "${STEAM_ARGS[@]}" \
        >> "$log_file" 2>&1

    status=$?


    {
        echo
        echo "========================================"
        echo " STEAMOS (GAMESCOPE) TERMINOU"
        echo "========================================"
        echo "Código de saída: $status"
        echo "Data: $(date)"
        echo
    } >> "$log_file" 2>&1


    # Encerramento normal.
    if [[ "$status" -eq 0 ]]; then
        return 0
    fi

    report_failure "STEAMOS (GAMESCOPE) FALHOU" "$log_file" "$status"
    return "$status"
}
