#!/bin/bash
# ============================================================
# compositors/kwin.sh
#
# Inicialização do KWin Wayland como compositor standalone,
# com a Steam (GamepadUI) rodando dentro da sessão.
# ============================================================

KWIN_BIN="/usr/bin/kwin_wayland"
KWIN_ARGS=(--xwayland)


start_kwin() {

    local log_file
    local status

    log_file="$(new_log_file kwin)"

    create_log_header "$log_file" "KWIN WAYLAND SESSION LOG"

    {
        echo "========== KWIN =========="
        "$KWIN_BIN" --version
        echo

        echo "========== EXECUÇÃO =========="
        echo "KWin + XWayland + Steam GamepadUI"
        echo
    } >> "$log_file" 2>&1


    # KWin inicia como compositor Wayland standalone.
    # O parâmetro -- inicia a Steam dentro da sessão do KWin.
    # --xwayland permite suporte aos componentes/jogos que precisam de X11.
    dbus-run-session \
        "$KWIN_BIN" \
        "${KWIN_ARGS[@]}" \
        -- \
        "$STEAM_BIN" "${STEAM_ARGS[@]}" \
        >> "$log_file" 2>&1

    status=$?


    {
        echo
        echo "========================================"
        echo " KWIN / STEAM TERMINOU"
        echo "========================================"
        echo "Código de saída: $status"
        echo "Data: $(date)"
        echo
    } >> "$log_file" 2>&1


    if [[ "$status" -eq 0 ]]; then
        return 0
    fi

    report_failure "KWIN / STEAM FALHOU" "$log_file" "$status"
    return "$status"
}
