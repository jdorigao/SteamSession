#!/bin/bash
# ============================================================
# compositors/openbox
#
# Steam Gaming Session
# Openbox + Xorg
# ============================================================

OPENBOX_BIN="/usr/bin/openbox"
STARTX_BIN="/usr/bin/startx"
XINITRC="$HOME/.config/openbox/xinitrc"


start_openbox() {

    local log_file
    local exit_status

    log_file="$(new_log_file openbox)"

    create_log_header "$log_file" "OPENBOX X11 SESSION LOG"


    # ========================================================
    # Verifica dependências
    # ========================================================

    for binary in "$OPENBOX_BIN" "$STARTX_BIN"; do

        if [[ ! -x "$binary" ]]; then

            {
                echo "ERRO: Executável não encontrado:"
                echo "$binary"
            } >> "$log_file" 2>&1

            report_failure "ERRO: DEPENDÊNCIA NÃO ENCONTRADA" "$log_file"

            return 1
        fi

    done


    # ========================================================
    # Verifica X já existente
    # ========================================================

    if pgrep -x Xorg >/dev/null 2>&1; then

        {
            echo "ERRO: Já existe um servidor Xorg ativo."
            echo
            pgrep -a Xorg
        } >> "$log_file" 2>&1

        report_failure "ERRO: XORG JÁ ESTÁ ATIVO" "$log_file"

        return 1
    fi


    # ========================================================
    # Cria xinitrc
    # ========================================================

    mkdir -p "$(dirname "$XINITRC")"


    cat > "$XINITRC" <<'EOF'
#!/bin/sh

export XDG_CURRENT_DESKTOP=Openbox
export XDG_SESSION_DESKTOP=Openbox
export XDG_SESSION_TYPE=x11

# ============================================================
# Steam Gaming
# ============================================================

steam -gamepadui &

# ============================================================
# Openbox
# ============================================================

exec openbox --startup
EOF

    chmod +x "$XINITRC"


    # ========================================================
    # Inicia Xorg + Openbox
    # ========================================================

    {
        echo "========== INICIANDO XORG =========="
        echo "Data: $(date)"
        echo
        echo "XINITRC=$XINITRC"
        echo
    } >> "$log_file" 2>&1


    "$STARTX_BIN" "$XINITRC" -- \
        :0 vt1 \
        >> "$log_file" 2>&1

    exit_status=$?


    # ========================================================
    # Sessão terminou
    # ========================================================

    {
        echo
        echo "========================================"
        echo " OPENBOX/X11 TERMINOU"
        echo "========================================"
        echo "Exit status: $exit_status"
    } >> "$log_file" 2>&1


    return "$exit_status"
}
