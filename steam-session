#!/bin/bash
set -u

# ============================================================
# STEAM GAMING SESSION
#
# Main script: loads lib/common and, automatically,
# all scripts found in compositors/. The menu is
# dynamically built from what is found there
# -- just add a new file to the compositors/ folder for
# it to appear in the menu, without needing to edit this file.
#
# Expected structure:
#   steam-session
#   ├── steam-session          <- this file
#   ├── lib/
#   │   └── common
#   └── compositors/
#       ├── niri
#       ├── kwin
#       ├── gamescope
#       ├── mutter
#       └── openbox
#
# CONVENTION for each file in compositors/:
#
#   - The file name is the "key" of the compositor (e.g., niri,
#     kwin, gamescope, mutter, openbox). This is the name that can be
#     used in DEFAULT_COMPOSITOR and as a command line argument.
#
#   - The file must define a start_<key> function (e.g.,
#     start_niri). This is the function that will be called when
#     selecting the item in the menu. It can be overridden by defining
#     the COMPOSITOR_FUNC variable before the end of the file.
#
#   - Optionally, the file can define COMPOSITOR_LABEL with
#     the text displayed in the menu (e.g., COMPOSITOR_LABEL="gamescope
#     (Gamescope)"). If not defined, the file name is used with the
#     first letter capitalized.
#
# Minimal example of compositors/hyprland:
#
#   COMPOSITOR_LABEL="Hyprland"
#   start_hyprland() {
#       exec Hyprland
#   }
#
# ============================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSITORS_DIR="$SCRIPT_DIR/compositors"

source "$SCRIPT_DIR/lib/common"


# ============================================================
# AUTOMATIC COMPOSITOR DISCOVERY
#
# Scans compositors/ and builds, in the order the files are
# found (alphabetical order), parallel lists:
#   COMPOSITOR_KEYS[i]   -> file name / key
#   COMPOSITOR_LABELS[i] -> text displayed in the menu
#   COMPOSITOR_FUNCS[i]  -> function to be called
# ============================================================

COMPOSITOR_KEYS=()
COMPOSITOR_LABELS=()
COMPOSITOR_FUNCS=()

if [[ -d "$COMPOSITORS_DIR" ]]; then

    for file in "$COMPOSITORS_DIR"/*; do

        [[ -f "$file" ]] || continue

        key="$(basename "$file")"

        # Ignore hidden files, backups, and the like.
        [[ "$key" == .* || "$key" == *~ || "$key" == *.bak ]] && continue

        # Variables that the file can (optionally) define.
        COMPOSITOR_LABEL=""
        COMPOSITOR_FUNC=""

        source "$file"

        label="${COMPOSITOR_LABEL:-${key^}}"
        func="${COMPOSITOR_FUNC:-start_$key}"

        if ! declare -F "$func" > /dev/null; then
            echo "Warning: '$file' does not define function '$func'; ignoring." >&2
            continue
        fi

        COMPOSITOR_KEYS+=("$key")
        COMPOSITOR_LABELS+=("$label")
        COMPOSITOR_FUNCS+=("$func")

    done

fi

COMPOSITOR_COUNT=${#COMPOSITOR_KEYS[@]}


# ============================================================
# CONFIGURATION (default compositor / skip menu)
# ============================================================
#
# File: ~/.config/steam-session/config
#
# Accepted variables:
#   DEFAULT_COMPOSITOR = <key from compositors/> | shell
#   SKIP_MENU          = true | false
#
# If SKIP_MENU="true", the menu is never shown: the script always
# launches DEFAULT_COMPOSITOR directly, even after the session
# ends (it loops back and auto-starts again).
#
# See config.example in this same directory.

DEFAULT_COMPOSITOR="niri"
SKIP_MENU="false"

CONFIG_FILE="$HOME/.config/steam-session/config"

if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
fi


# ============================================================
# NVIDIA SHADER CACHE
# ============================================================

export __GL_SHADER_DISK_CACHE=1
export __GL_SHADER_DISK_CACHE_SIZE=12000000000

# ============================================================
# MANGOHUD
# ============================================================

export MANGOHUD=1

# ============================================================
# SHELL
# ============================================================

start_shell() {

    clear

    echo "=================================="
    echo "             SHELL"
    echo "=================================="
    echo

    exec bash
}


# ============================================================
# REBOOT
# ============================================================

reboot_system() {

    clear
    echo "Restarting..."

    sleep 1

    systemctl reboot
}


# ============================================================
# SHUTDOWN
# ============================================================

shutdown_system() {

    clear
    echo "Shutting down..."

    sleep 1

    systemctl poweroff
}


# ============================================================
# MENU
#
# The compositors (1..N) come from the automatic discovery above.
# Shell / Reboot / Shutdown are always the last 3 items.
# ============================================================

show_menu() {

    clear

    echo "=================================="
    echo "        STEAM GAMING SESSION"
    echo "=================================="
    echo

    local i
    for ((i = 0; i < COMPOSITOR_COUNT; i++)); do
        printf "  %d) %s\n" "$((i + 1))" "${COMPOSITOR_LABELS[$i]}"
    done

    echo "  $((COMPOSITOR_COUNT + 1))) Shell"
    echo "  $((COMPOSITOR_COUNT + 2))) Reboot"
    echo "  $((COMPOSITOR_COUNT + 3))) Shutdown"
    echo
    echo "Current default: $DEFAULT_COMPOSITOR  (SKIP_MENU=$SKIP_MENU)"
    echo
}


# ============================================================
# DISPATCH
#
# Accepts both the menu number or the compositor key
# (file name in compositors/), used by
# DEFAULT_COMPOSITOR in the configuration file or via command
# line argument.
# Returns 0 to "continue loop" and 9 for "invalid option".
# ============================================================

dispatch_compositor() {

    local choice="$1"
    local i

    # Numeric item from discovered compositors.
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= COMPOSITOR_COUNT )); then
        "${COMPOSITOR_FUNCS[$((choice - 1))]}"
        return 0
    fi

    # Fixed numeric items: Shell / Reboot / Shutdown.
    if [[ "$choice" == "$((COMPOSITOR_COUNT + 1))" ]]; then
        start_shell
        return 0
    fi

    if [[ "$choice" == "$((COMPOSITOR_COUNT + 2))" ]]; then
        reboot_system
        exit
    fi

    if [[ "$choice" == "$((COMPOSITOR_COUNT + 3))" ]]; then
        shutdown_system
        exit
    fi

    # Fixed keywords.
    case "$choice" in
        shell)
            start_shell
            return 0
            ;;
        reboot)
            reboot_system
            exit
            ;;
        shutdown)
            shutdown_system
            exit
            ;;
    esac

    # Key of a discovered compositor in compositors/.
    for ((i = 0; i < COMPOSITOR_COUNT; i++)); do
        if [[ "$choice" == "${COMPOSITOR_KEYS[$i]}" ]]; then
            "${COMPOSITOR_FUNCS[$i]}"
            return 0
        fi
    done

    return 9
}


# ============================================================
# ARGUMENT
# ============================================================

# A command line argument always has priority and is
# used only once (compositor key or number). After
# that, the behavior depends on SKIP_MENU:
#
#   SKIP_MENU=false -> returns to showing the menu normally.
#   SKIP_MENU=true  -> returns to launching DEFAULT_COMPOSITOR directly.
#
# Pass "menu" as an argument to force showing the menu
# even with SKIP_MENU=true in the configuration file.
#
# Examples:
#   steam-session           -> uses DEFAULT_COMPOSITOR/SKIP_MENU from config
#   steam-session niri      -> Niri
#   steam-session kwin      -> KWin
#   steam-session gamescope -> gamescope
#   steam-session menu      -> forces showing the menu

ARG="${1:-}"
FORCE_MENU="false"

if [[ "$ARG" == "menu" ]]; then
    FORCE_MENU="true"
    ARG=""
fi

ONCE="$ARG"


# ============================================================
# MAIN LOOP
# ============================================================

while true; do

    if [[ -n "$ONCE" ]]; then
        # Command line argument: used only once.
        choice="$ONCE"
        ONCE=""

    elif [[ "$SKIP_MENU" == "true" && "$FORCE_MENU" == "false" ]]; then
        # No menu: always restart the default compositor.
        choice="$DEFAULT_COMPOSITOR"

    else
        show_menu
        read -rp "Select [1-$((COMPOSITOR_COUNT + 3))]: " choice
    fi


    if ! dispatch_compositor "$choice"; then

        clear

        echo "=================================="
        echo "         INVALID OPTION"
        echo "=================================="
        echo
        echo "Selected option: $choice"
        echo

        sleep 2
    fi

done
